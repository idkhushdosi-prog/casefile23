# Supabase Project Credentials (required for automatic cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret key (used by /editor, /api/submission/complete, & scripts/seed-test-data.ts — never exposed to students)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret passcode for the student editor to unlock /editor (no email required)
EDITOR_PASSCODE=choose-a-secret-passcode

# Auto-email complete ZIP archive when all 23/23 students submit
ARCHIVE_NOTIFY_EMAIL=your-email@example.com

# Email Transport Option 1 (Recommended — Resend API: https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM="CASE FILE 23 <onboarding@resend.dev>"

# Email Transport Option 2 (Alternative — Gmail / SMTP via App Password, leave blank if using Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
